{
  "name": "@crabcode/crabcopyright-cn",
  "version": "0.3.0",
  "private": true,
  "description": "Deterministic source-material runtime for the crabcopyright-cn workflow plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "crabcopyright-source": "./dist/source-core.js"
  },
  "scripts": {
    "build": "bun build src/source-core-cli.ts --outfile dist/source-core.js --target node --format esm --banner '#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test ./tests",
    "check:distribution": "bun run scripts/check-source-core-distribution.ts",
    "sbom": "bun run scripts/generate-sbom.ts",
    "sbom:check": "bun run scripts/generate-sbom.ts --check",
    "personal:port": "bun run scripts/build-codex-port.ts"
  },
  "dependencies": {
    "chardet": "2.0.0",
    "docx": "8.5.0",
    "fast-glob": "3.3.2",
    "iconv-lite": "0.6.3",
    "ignore": "5.3.1",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/node": "^20.14.0",
    "typescript": "^5.9.3"
  }
}
