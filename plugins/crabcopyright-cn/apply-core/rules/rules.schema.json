{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crabcode.local/schemas/crabcopyright-rules.schema.json",
  "title": "CrabCopyright-CN Rule Registry",
  "type": "object",
  "required": ["registry_version", "rules_version", "verified_at", "rules"],
  "properties": {
    "registry_version": {"type": "integer", "const": 1},
    "rules_version": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "format": "date"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "source_url", "effective_from", "severity", "mechanical_check"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
          "kind": {"enum": ["official", "platform", "practice"]},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "effective_from": {"type": "string", "format": "date"},
          "effective_to": {"type": ["string", "null"], "format": "date"},
          "last_verified_at": {"type": "string", "format": "date"},
          "severity": {"enum": ["info", "warn", "fail", "blocked"]},
          "mechanical_check": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
