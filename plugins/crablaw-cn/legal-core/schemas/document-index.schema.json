{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crablaw.local/schemas/legal-core/document-index.schema.json",
  "title": "CrabLaw-CN Document Index",
  "type": "object",
  "required": ["schemaVersion", "runId", "matterId", "documents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,120}$" },
    "matterId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["documentId", "sourceRecordId", "path", "sha256", "status", "coverage", "issueIds", "confidentiality"],
        "properties": {
          "documentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,120}$" },
          "sourceRecordId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,120}$" },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["registered", "read-complete", "read-partial", "unreadable", "superseded"] },
          "coverage": {
            "type": "object",
            "required": ["scope", "complete", "ocrQuality"],
            "properties": {
              "scope": { "type": "string", "minLength": 1 },
              "complete": { "type": "boolean" },
              "ocrQuality": { "enum": ["not-applicable", "high", "medium", "low", "failed"] },
              "missingRanges": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "notes": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "issueIds": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
          "confidentiality": { "enum": ["standard", "heightened", "clean-team"] },
          "supersedesDocumentId": { "type": "string", "minLength": 2 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
