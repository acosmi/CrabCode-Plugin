{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crablaw.local/schemas/legal-core/case-comparison.schema.json",
  "title": "CrabLaw-CN Case Comparison",
  "type": "object",
  "required": ["schemaVersion", "matterId", "runId", "issueId", "searchDate", "sourcesSearched", "cases", "conclusion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matterId": { "type": "string", "minLength": 2 },
    "runId": { "type": "string", "minLength": 2 },
    "issueId": { "type": "string", "minLength": 2 },
    "searchDate": { "type": "string", "format": "date" },
    "sourcesSearched": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceRecordId", "caseTitle", "court", "caseDate", "factsMatch", "ruleOrHolding", "difference", "weight", "citationTag"],
        "properties": {
          "sourceRecordId": { "type": "string", "minLength": 2 },
          "caseTitle": { "type": "string", "minLength": 1 },
          "court": { "type": "string", "minLength": 1 },
          "caseDate": { "type": "string", "minLength": 1 },
          "factsMatch": { "type": "string", "minLength": 1 },
          "ruleOrHolding": { "type": "string", "minLength": 1 },
          "difference": { "type": "string", "minLength": 1 },
          "weight": { "enum": ["guiding", "reference", "similar", "weak", "distinguishable"] },
          "citationTag": { "enum": ["[已核验-来源]", "[用户提供]", "[模型知识-待核]"] }
        },
        "additionalProperties": false
      }
    },
    "caseSearchLimitations": { "type": "string", "minLength": 1 },
    "conclusion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
