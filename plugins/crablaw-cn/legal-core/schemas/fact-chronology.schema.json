{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crablaw.local/schemas/legal-core/fact-chronology.schema.json",
  "title": "CrabLaw-CN Fact Chronology",
  "type": "object",
  "required": ["schemaVersion", "runId", "matterId", "facts", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 2 },
    "matterId": { "type": "string", "minLength": 2 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["factId", "statement", "sourceDocumentIds", "evidenceIds", "status", "confidenceBasis"],
        "properties": {
          "factId": { "type": "string", "minLength": 2 },
          "statement": { "type": "string", "minLength": 1 },
          "sourceDocumentIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
          "occurredAt": { "type": "string", "minLength": 1 },
          "status": { "enum": ["user-alleged", "document-stated", "disputed", "corroborated", "unknown"] },
          "confidenceBasis": { "type": "string", "minLength": 1 },
          "missing": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "documentId", "pinpoint", "purpose", "authenticity", "legality", "relevance", "weight"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 2 },
          "documentId": { "type": "string", "minLength": 2 },
          "pinpoint": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "authenticity": { "enum": ["unreviewed", "supported", "disputed", "insufficient"] },
          "legality": { "enum": ["unreviewed", "supported", "disputed", "insufficient"] },
          "relevance": { "enum": ["unreviewed", "supported", "disputed", "insufficient"] },
          "weight": { "enum": ["unknown", "weak", "medium", "strong"] },
          "notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
