{
  "name": "crabcode-media-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "CrabPublish Hub local UI and acceptance harness. Real publishing side effects are disabled in 0.1.0.",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/serve-ui.ts --dev",
    "preview": "bun run scripts/serve-ui.ts",
    "build": "bun run scripts/build-ui.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && bun run scripts/lint-ui.ts",
    "test": "bun test packages/domain/tests tests/unit tests/security",
    "test:browser": "bun run build && playwright test --workers=1 --retries=0 --forbid-only --fail-on-flaky-tests --update-snapshots=none",
    "test:browser:update": "bun run build && playwright test --workers=1 --retries=0 --forbid-only --update-snapshots=all",
    "qa:nu": "bun run build && bun run scripts/validate-html.ts",
    "qa": "bun run lint && bun run test && bun run qa:nu && bun run test:browser"
  },
  "dependencies": {
    "hast-util-to-text": "4.0.2",
    "hast-util-to-mdast": "10.1.2",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "vnu-jar": "26.7.15"
  }
}
